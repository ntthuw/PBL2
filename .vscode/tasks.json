{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build PBL2 GUI",
            "type": "cppbuild",
            "command": "C:\\msys64\\ucrt64\\bin\\g++.exe",
            "args": [
                "-std=c++11",
                "-Wall",
                "-Wextra",
                "-I.",
                "-IObjects",
                "-IManagers",
                "-IFileIO",
                "-IPolicies",
                "main.cpp",
                "EmployeeWorkSystem.cpp",
                "Objects/Assignment.cpp",
                "Objects/Attendance.cpp",
                "Objects/Customer.cpp",
                "Objects/Driver.cpp",
                "Objects/Employee.cpp",
                "Objects/Expense.cpp",
                "Objects/Invoice.cpp",
                "Objects/Janitor.cpp",
                "Objects/Manager.cpp",
                "Objects/User.cpp",
                "Objects/Vehicle.cpp",
                "Managers/AssignmentManager.cpp",
                "Managers/AttendanceManager.cpp",
                "Managers/AuthManager.cpp",
                "Managers/CustomerManager.cpp",
                "Managers/EmployeeManager.cpp",
                "Managers/ExpenseManager.cpp",
                "Managers/InvoiceManager.cpp",
                "Managers/VehicleManager.cpp",
                "FileIO/FileManager.cpp",
                "Policies/FeePolicy.cpp",
                "-o",
                "PBL2_GUI.exe",
                "-LC:/msys64/ucrt64/lib",
                "-lraylib",
                "-lopengl32",
                "-lgdi32",
                "-lwinmm"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "Run PBL2 GUI",
            "type": "process",
            "command": "${workspaceFolder}\\PBL2_GUI.exe",
            "dependsOn": "Build PBL2 GUI",
            "dependsOrder": "sequence",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        }
    ]
}
